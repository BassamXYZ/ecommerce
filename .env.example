# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True

# Hosts
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Database
## Application database connection
# DATABASE_URL=postgresql://...
## Optional direct connection
# DATABASE_URL_UNPOOLED=postgresql://...

# Internationalization
TIME_ZONE=UTC

# Admin notifications (optional)
ADMIN_NAME=Bassam
ADMIN_EMAIL=

# Payeer
PAYEER_SHOP_ID=12345

# Neon Object Storage (S3-compatible) for product images.
# Leave all of these empty to store images locally in ./media during development.
# The bucket must be created with the "public_read" access level.
AWS_STORAGE_BUCKET_NAME=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
